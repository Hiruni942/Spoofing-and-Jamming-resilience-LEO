    "    (\"Independent Time Reference\", \"LEO can provide timing independent of GPS\"),\n",
    "    (\"Outlier Detection\", \"Statistical analysis of multi-constellation residuals identifies spoofing\")\n",
    "]\n",
    "\n",
    "for i, (strategy, description) in enumerate(strategies, 1):\n",
    "    print(f\"\\n{i}. {strategy}\")\n",
    "    print(f\"   → {description}\")"
   ]
  },
