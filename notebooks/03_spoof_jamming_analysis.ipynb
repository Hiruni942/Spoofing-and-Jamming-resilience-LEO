   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notebook 3: Spoofing and Jamming Resilience Analysis\n",
    "\n",
    "This notebook explores cross-layer PNT resilience using LEO and GPS constellations.\n",
    "\n",
    "## Topics:\n",
    "- GPS spoofing and jamming threat scenarios\n",
    "- LEO constellation advantages for PNT\n",
    "- Cross-layer validation concepts\n",
    "- Signal visibility and geometry\n",
    "- Resilience metrics and detection strategies"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup: Import and Initialize"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Import constellation and signal functions\n",
    "from gnss_leo.core import (\n",
    "    create_leo_constellation, create_gps_constellation,\n",
    "    propagate_constellation,\n",
    "    R_EARTH, SIMULATION_TIME, DEFAULT_NUM_STEPS\n",
    ")\n",
    "\n",
    "from gnss_leo.signal import (\n",
    "    calculate_distance,\n",
    "    calculate_doppler_shift,\n",
    "    calculate_radial_velocity,\n",
    "    calculate_elevation_angle,\n",
    "    is_visible,\n",
    "    calculate_pseudorange,\n",
    "    path_loss,\n",
    "    signal_to_noise_ratio,\n",
    "    calculate_c_n0\n",
    ")\n",
    "\n",
    "print(\"✓ Imports successful\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 1: Constellation Geometry Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create constellations\n",
    "print(\"Creating satellite constellations...\")\n",
    "gps_const = create_gps_constellation(num_planes=6, satellites_per_plane=4)\n",
    "leo_const = create_leo_constellation(num_planes=2, satellites_per_plane=3)\n",
    "\n",
    "print(f\"GPS constellation: {len(gps_const)} satellites in 6 orbital planes\")\n",
    "print(f\"LEO constellation: {len(leo_const)} satellites in 2 orbital planes\")\n",
    "\n",
    "# Simulation\n",
    "times = np.linspace(0, SIMULATION_TIME, DEFAULT_NUM_STEPS)\n",
    "print(f\"\\nSimulation: {SIMULATION_TIME/3600:.1f} hours with {len(times)} steps\")\n",
    "\n",
    "# Propagate\n",
    "print(\"\\nPropagating constellations...\")\n",
    "gps_pos, gps_vel = propagate_constellation(gps_const, times)\n",
    "leo_pos, leo_vel = propagate_constellation(leo_const, times)\n",
    "print(\"✓ Done\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 2: Signal Visibility Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Receiver location: mid-latitude\n",
    "lat = np.deg2rad(40)  # 40° North\n",
    "lon = np.deg2rad(0)   # Prime Meridian\n",
    "alt = 100  # meters\n",
    "\n",
    "# Convert to ECEF\n",
    "a = 6378137.0\n",
    "e2 = 0.00669437999014\n",
    "N = a / np.sqrt(1 - e2 * np.sin(lat)**2)\n",
    "rx_x = (N + alt) * np.cos(lat) * np.cos(lon)\n",
    "rx_y = (N + alt) * np.cos(lat) * np.sin(lon)\n",
    "rx_z = (N * (1 - e2) + alt) * np.sin(lat)\n",
    "receiver = np.array([rx_x, rx_y, rx_z])\n",
    "\n",
    "print(f\"Receiver location: {np.rad2deg(lat):.1f}°N, {np.rad2deg(lon):.1f}°E\")\n",
    "\n",
    "# Count visible satellites at each time\n",
    "min_elevation = np.deg2rad(10)  # 10° above horizon\n",
    "\n",
    "gps_visible_count = []\n",
    "leo_visible_count = []\n",
    "\n",
    "for t_idx in range(0, len(times), 10):  # Every 10 steps for speed\n",
    "    gps_count = 0\n",
    "    for sat_name in gps_pos:\n",
    "        sat_pos = gps_pos[sat_name][t_idx]\n",
    "        if is_visible(receiver, sat_pos, min_elevation=min_elevation):\n",
    "            gps_count += 1\n",
    "    \n",
    "    leo_count = 0\n",
    "    for sat_name in leo_pos:\n",
    "        sat_pos = leo_pos[sat_name][t_idx]\n",
    "        if is_visible(receiver, sat_pos, min_elevation=min_elevation):\n",
    "            leo_count += 1\n",
    "    \n",
    "    gps_visible_count.append(gps_count)\n",
    "    leo_visible_count.append(leo_count)\n",
    "\n",
    "times_sparse = times[::10] / 3600  # Hours\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "ax.plot(times_sparse, gps_visible_count, 'b-o', label='GPS', linewidth=2, markersize=6)\n",
    "ax.plot(times_sparse, leo_visible_count, 'r-s', label='LEO', linewidth=2, markersize=6)\n",
    "ax.axhline(y=4, color='b', linestyle='--', alpha=0.3, label='Min for GPS fix (4)')\n",
    "ax.set_xlabel('Time [hours]')\n",
    "ax.set_ylabel('Number of Visible Satellites')\n",
    "ax.set_title(f'Signal Visibility ({np.rad2deg(min_elevation):.0f}° elevation mask)')\n",
    "ax.legend(fontsize=11)\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax.set_ylim([0, max(gps_visible_count + leo_visible_count) + 2])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('03_visibility_analysis.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"✓ Saved: 03_visibility_analysis.png\")\n",
    "\n",
    "print(f\"\\nVisibility Statistics (≥{np.rad2deg(min_elevation):.0f}° elevation):\")\n",
    "print(f\"GPS: {np.mean(gps_visible_count):.1f} ± {np.std(gps_visible_count):.1f} sats\")\n",
    "print(f\"LEO: {np.mean(leo_visible_count):.1f} ± {np.std(leo_visible_count):.1f} sats\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 3: Cross-Layer Redundancy Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate constellation orbits over time\n",
    "# This demonstrates how LEO provides continuous coverage vs GPS periodic availability\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# GPS constellation at multiple times\n",
    "time_indices = [0, len(times)//4, len(times)//2, 3*len(times)//4]\n",
    "colors = ['red', 'orange', 'green', 'blue']\n",
    "\n",
    "ax = axes[0]\n",
    "for t_idx, color in zip(time_indices, colors):\n",
    "    for sat_name in list(gps_pos.keys())[:8]:  # Show first 8 sats\n",
    "        pos = gps_pos[sat_name][t_idx]\n",
    "        ax.scatter(pos[0]/1e6, pos[1]/1e6, s=30, c=color, alpha=0.6)\n",
    "\n",
    "# Earth\n",
    "circle = plt.Circle((0, 0), R_EARTH/1e6, color='yellow', fill=True, alpha=0.3)\n",
    "ax.add_patch(circle)\n",
    "ax.set_xlim([-30, 30])\n",
    "ax.set_ylim([-30, 30])\n",
    "ax.set_aspect('equal')\n",
    "ax.set_xlabel('X [Mm]')\n",
    "ax.set_ylabel('Y [Mm]')\n",
    "ax.set_title('GPS Constellation Snapshots (Top View)')\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# LEO constellation\n",
    "ax = axes[1]\n",
    "for t_idx, color in zip(time_indices, colors):\n",
    "    for sat_name in leo_pos:\n",
    "        pos = leo_pos[sat_name][t_idx]\n",
    "        ax.scatter(pos[0]/1e6, pos[1]/1e6, s=30, c=color, alpha=0.6)\n",
    "\n",
    "circle = plt.Circle((0, 0), R_EARTH/1e6, color='yellow', fill=True, alpha=0.3)\n",
    "ax.add_patch(circle)\n",
    "ax.set_xlim([-10, 10])\n",
    "ax.set_ylim([-10, 10])\n",
    "ax.set_aspect('equal')\n",
    "ax.set_xlabel('X [Mm]')\n",
    "ax.set_ylabel('Y [Mm]')\n",
    "ax.set_title('LEO Constellation Snapshots (Top View)')\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('03_constellation_geometry.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"✓ Saved: 03_constellation_geometry.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 4: Pseudorange Inconsistency Detection\n",
    "\n",
    "Demonstrates detection of spoofed signals via cross-layer validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simulate pseudorange measurements with potential spoof\n",
    "# GPS L1 frequency\n",
    "gps_l1_freq = 1.57542e9\n",
    "\n",
    "# Select time step\n",
    "t_idx = len(times) // 2  # Mid-simulation\n",
    "\n",
    "# Collect pseudorange measurements\n",
    "gps_measurements = {}\n",
    "leo_measurements = {}\n",
    "\n",
    "for sat_name in gps_pos:\n",
    "    if is_visible(receiver, gps_pos[sat_name][t_idx], min_elevation=min_elevation):\n",
    "        pr = calculate_pseudorange(receiver, gps_pos[sat_name][t_idx])\n",
    "        gps_measurements[sat_name] = pr\n",
    "\n",
    "for sat_name in leo_pos:\n",
    "    if is_visible(receiver, leo_pos[sat_name][t_idx], min_elevation=min_elevation):\n",
    "        pr = calculate_pseudorange(receiver, leo_pos[sat_name][t_idx])\n",
    "        leo_measurements[sat_name] = pr\n",
    "\n",
    "print(f\"Visible measurements at t={times[t_idx]/3600:.2f} hours:\")\n",
    "print(f\"GPS: {len(gps_measurements)} satellites\")\n",
    "print(f\"LEO: {len(leo_measurements)} satellites\")\n",
    "\n",
    "# Simulate spoofed signal scenario\n",
    "# Add artificial delay to some GPS measurements\n",
    "spoof_delay = 1000  # meters\n",
    "spoofed_gps = gps_measurements.copy()\n",
    "num_spoofed = min(2, len(spoofed_gps))\n",
    "spoofed_sats = list(spoofed_gps.keys())[:num_spoofed]\n",
    "\n",
    "for sat_name in spoofed_sats:\n",
    "    spoofed_gps[sat_name] += spoof_delay\n",
    "\n",
    "print(f\"\\n✓ Simulated spoofing: Added {spoof_delay}m delay to {num_spoofed} GPS signals\")\n",
    "print(f\"  Spoofed satellites: {spoofed_sats}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Section 5: Cross-Layer Validation Concept"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demonstrate cross-layer validation concept\n",
    "# LEO satellites can validate GPS measurements via their own timing/positioning\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# Plot GPS measurements\n",
    "sat_names = list(gps_measurements.keys())\n",
    "genuine_ranges = np.array([gps_measurements[name] for name in sat_names])\n",
    "spoofed_ranges = np.array([spoofed_gps[name] for name in sat_names])\n",
    "is_spoofed = [name in spoofed_sats for name in sat_names]\n",
    "\n",
    "ax = axes[0]\n",
    "colors = ['red' if spoofed else 'blue' for spoofed in is_spoofed]\n",
    "ax.bar(range(len(sat_names)), spoofed_ranges/1e6, color=colors, alpha=0.7, edgecolor='black')\n",
    "ax.axhline(y=np.mean(genuine_ranges)/1e6, color='g', linestyle='--', linewidth=2, label='True mean')\n",
    "ax.set_xlabel('Satellite')\n",
    "ax.set_ylabel('Pseudorange [Mm]')\n",
    "ax.set_title('GPS Pseudorange Measurements (Red = Spoofed)')\n",
    "ax.set_xticks(range(len(sat_names)))\n",
    "ax.set_xticklabels(sat_names, rotation=45)\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "# Detection: residual analysis\n",
    "mean_range = np.mean(genuine_ranges)\n",
    "residuals = spoofed_ranges - mean_range\n",
    "residual_std = np.std(residuals)\n",
    "\n",
    "ax = axes[1]\n",
    "colors = ['red' if abs(res) > 2*residual_std else 'green' for res in residuals]\n",
    "ax.bar(range(len(sat_names)), residuals/1e3, color=colors, alpha=0.7, edgecolor='black')\n",
    "ax.axhline(y=2*residual_std/1e3, color='r', linestyle='--', alpha=0.5, label=f'Threshold (±2σ)')\n",
    "ax.axhline(y=-2*residual_std/1e3, color='r', linestyle='--', alpha=0.5)\n",
    "ax.set_xlabel('Satellite')\n",
    "ax.set_ylabel('Measurement Residual [km]')\n",
    "ax.set_title('Pseudorange Residuals (Outlier Detection)')\n",
    "ax.set_xticks(range(len(sat_names)))\n",
    "ax.set_xticklabels(sat_names, rotation=45)\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('03_spoofing_detection.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"✓ Saved: 03_spoofing_detection.png\")\n",
    "\n",
    "print(f\"\\nOutlier Detection Results:\")\n",
    "print(f\"Mean pseudorange: {mean_range/1e6:.2f} Mm\")\n",
    "print(f\"Residual std: {residual_std/1e3:.2f} km\")\n",
    "for i, sat_name in enumerate(sat_names):\n",
    "    residual = residuals[i]\n",
    "    detection = 'SPOOFED ⚠️' if abs(residual) > 2*residual_std else 'OK ✓'\n",
    "    print(f\"{sat_name}: Residual = {residual/1e3:>6.2f} km  [{detection}]\")"
   ]
  },
